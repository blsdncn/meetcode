# Meetcode Frontend Environment Example
# Copy to .env.frontend and fill in your values

# ===========================================
# NextAuth Configuration (Required)
# ===========================================
# Full URL where the app is hosted
# Dev (Local): http://localhost:3000
# Prod (Docker): https://meetcode.app
NEXTAUTH_URL=http://localhost:3000

# NextAuth encryption secret
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32

# ===========================================
# Backend URL (Server-Side Internal Calls)
# ===========================================
# 🚨 CRITICAL CONFIGURATION 🚨
#
# FOR LOCAL DEV (Run via 'npm run dev'):
# Use: https://localhost
# Why? You are running ON THE HOST. 'backend:8000' is hidden inside Docker.
# You must go through Nginx (port 443) to reach it.
#
# FOR DOCKER (Run via 'docker compose'):
# Use: http://backend:8000
# Why? The container is INSIDE the network and talks directly to the backend.
BACKEND_URL=https://localhost

# For Local Dev with Self-Signed Certs, allow insecure SSL
NODE_TLS_REJECT_UNAUTHORIZED=0

# ===========================================
# OAuth Providers (Optional)
# Leave empty if not using OAuth
# ===========================================
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
