
# Environment variables for Docker deployment with reverse proxy
# No longer need NEXT_PUBLIC_API_URL since we use relative URLs that work through Nginx

# NEXT_PUBLIC_API_URL left blank - we now use relative URLs
NEXT_PUBLIC_API_URL=

# Legacy commented out URLs for reference
# NEXT_PUBLIC_API_URL=http://localhost:8000/
# NEXT_PUBLIC_API_URL=https://backend:8000    # no longer needed
# NEXT_PUBLIC_API_URL=https://localhost:8000/