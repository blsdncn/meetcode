# === FASTAPI / UVICORN SPECIFIC ===

# Miscellaneous
instance/

*.session.sql
backend/test.db
dockerstuff/

# === SECURITY: Environment Files ===
# Never commit runtime secrets to version control

# Ignore all .env files by default
*.env

# Allow .env.example templates (safe for public consumption)
!**/.env.example
!**/.env.production

# Explicitly ignore runtime environment files with secrets
**/.env.runtime
**/.env.local
**/.env.*.local

# === SECURITY: SSL Certificates ===
# Never commit private keys or certificates to version control

**/certs/*.pem
**/certs/*.key
**/certs/*.crt
**/certs/*.csr

# Keep placeholder files
!**/.gitkeep

# Allow certificate generation scripts
!**/init_certs.sh

# Development notes and temporary fix summaries
*-SUMMARY.md
*-FIX-*.md
*-MIGRATION.md
reviews-*.md
