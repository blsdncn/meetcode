# Meetcode Backend Environment Example
# Copy to .env.backend and fill in your values
#
# For local fastapi dev (without Docker):
#   DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/meetcode
# For Docker dev/prod:
#   DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db:5432/meetcode

# ===========================================
# Database Configuration
# ===========================================
DATABASE_URL=postgresql://postgres:YOUR_SECURE_PASSWORD@db:5432/meetcode
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD

# ===========================================
# JWT Secrets (MUST be unique per deployment)
# Generate with: openssl rand -hex 32
# ===========================================
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
SECRET_KEY_ACCESS=CHANGE_ME_generate_with_openssl_rand_hex_32
SECRET_KEY_REFRESH=CHANGE_ME_generate_with_openssl_rand_hex_32

# ===========================================
# CORS Configuration
# Comma-separated list of allowed origins
# ===========================================
CORS_ORIGINS=https://localhost,http://localhost
